{
  "expo": {
    "name": "FaceeRecognition",
    "slug": "FaceeRecognition",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Esta app necesita acceso a la cámara para tomar fotos."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Esta app necesita guardar fotos en tu galería.",
          "photosPermission": "Esta app necesita acceder a tus fotos."
        }
      ]
    ]
  }
}
