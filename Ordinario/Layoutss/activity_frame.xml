<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/viewFondo"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="#2196F3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSuperpuesto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Texto Superpuesto\n(Estilo FrameLayout)"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/viewFondo"
        app:layout_constraintEnd_toEndOf="@+id/viewFondo"
        app:layout_constraintStart_toStartOf="@+id/viewFondo"
        app:layout_constraintTop_toTopOf="@+id/viewFondo" />

</androidx.constraintlayout.widget.ConstraintLayout>